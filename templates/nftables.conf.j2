#!/usr/sbin/nft -f
   
flush ruleset

table inet filter {
    chain input {
        type filter hook input priority 0; policy accept;
    }

    chain forward {
        type filter hook forward priority 0; policy accept;

        # TCP MSS Clamping: 针对 WireGuard 等接口自动调整 MSS
        oifname "wg*" tcp flags syn tcp option maxseg size set rt mtu

        # Guest 网段(30 段)隔离: 仅允许上网,不得与内网(10 段)互通
        # 已建立/相关连接放行(保证 10 段主动访问的回程不被误伤)
        ct state established,related accept
        # 双向丢弃 30<->10, 阻断 Guest 与内网互访
        ip saddr {{ GW_NET_30 }} ip daddr {{ GW_NET_10 }} drop
        ip saddr {{ GW_NET_10 }} ip daddr {{ GW_NET_30 }} drop
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}

table ip nat {
    chain prerouting {
        type nat hook prerouting priority -100;
    }

    chain postrouting {
        type nat hook postrouting priority 100;

        # WAN 口动态 SNAT (Masquerade)
        oifname { {% for i in wan_ifaces %}"{{ i }}"{% if not loop.last %}, {% endif %}{% endfor %} } masquerade
    }
}
