auto lo
iface lo inet loopback

# OOB 接口 (eth0, DHCP)
auto eth0
iface eth0 inet dhcp

# HA 接口 (eth1)
auto eth1
iface eth1 inet static
    address {{ interfaces.eth1 }}

# ISP1 (eth2) / ISP2 (eth3) —— WAN
# IP 由 link-balancer / keepalived 按 GW_ISPx_* 变量接管,
# 此处仅拉起链路(link up)，不静态配置地址。
auto eth2
iface eth2 inet manual
    up ip link set dev eth2 up

auto eth3
iface eth3 inet manual
    up ip link set dev eth3 up

# LAN 接口 (eth4)
auto eth4
iface eth4 inet static
    address {{ interfaces.eth4 }}
    up ip route add {{ GW_NET_10 }} via {{ GW_CSW_IP }} dev {{ GW_LAN_Iface }} proto 5
    up ip route add {{ GW_NET_30 }} via {{ GW_CSW_IP }} dev {{ GW_LAN_Iface }}
#    up ip route add default via {{ GW_CSW_IP }} dev {{ GW_LAN_Iface }} metric 999
#    up ip -6 route add fdbd:ff1:ce00:7640::/59 via fdbd:ff1:ce00:7640::6 proto lan
